<odoo>
    <record id="fsm_checklist_list_view" model="ir.ui.view">
        <field name="name">fsm.checklist.list.view</field>
        <field name="model">fsm.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" placeholder="e.g. Conference for Architects"/>
            </list>
        </field>
    </record>
    <record id="fsm_checklist_form_view" model="ir.ui.view">
        <field name="name">fsm.checklist.form.view</field>
        <field name="model">fsm.checklist</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Intrusion Detection"/>
                    </group>
                    <group>
                        <notebook>
                            <page string="Checklist Items" name="items">
                                <field name="checklist_item_ids">
                                    <list editable="bottom">

                                        <field name="name"/>
                                        <field name="checklist_type"/>
                                        <field name="field_ttype"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="checklist_action" model="ir.actions.act_window">
        <field name="name">Checklist</field>
        <field name="res_model">fsm.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Checklist
            </p>
        </field>
    </record>
</odoo>