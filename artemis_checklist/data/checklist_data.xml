        <field name="checklist_id" ref="checklist_1"/>
        <field name="name">Volume Control</field>
        <field name="checklist_type">good/na/bad</field>
        <field name="field_ttype">selection</field>
    </record>
    <record id="checklist_1_checklist_item_2" model="fsm.checklist.item">
